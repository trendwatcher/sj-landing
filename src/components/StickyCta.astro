---
import { CONTACT } from '../consts';
---

<div class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white/95 p-3 shadow-[0_-4px_16px_rgba(15,23,42,0.08)] backdrop-blur md:hidden">
	<a
		href={CONTACT.phoneHref}
		class="block rounded-xl bg-indigo-600 py-4 text-center text-base font-bold text-white"
	>
		📞 무료 상담 전화하기 {CONTACT.phone}
	</a>
</div>
