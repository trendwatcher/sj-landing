---
import { CONTACT } from '../consts';
---

<div class="fixed inset-x-0 bottom-0 z-50 border-t border-cream-300 bg-cream-50/95 p-3 shadow-[0_-4px_20px_rgba(47,41,34,0.08)] backdrop-blur md:hidden">
	<a
		href={CONTACT.phoneHref}
		class="block rounded-2xl bg-gradient-to-r from-brand-500 to-brand-600 py-4 text-center text-base font-bold text-white shadow-lg shadow-brand-500/25"
	>
		📞 무료 상담 전화하기 {CONTACT.phone}
	</a>
</div>
