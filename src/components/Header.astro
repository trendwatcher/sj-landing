---
import { CONTACT, SITE } from '../consts';
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
		<a href="#top" class="text-base font-bold tracking-tight text-slate-900">
			{SITE.name}
		</a>

		<nav class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
			<a href="#problem" class="hover:text-indigo-600">이런 고민</a>
			<a href="#solution" class="hover:text-indigo-600">컨설팅</a>
			<a href="#courses" class="hover:text-indigo-600">VOD 과정</a>
			<a href="#faq" class="hover:text-indigo-600">자주 묻는 질문</a>
		</nav>

		<a
			href={CONTACT.phoneHref}
			class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
		>
			<span class="hidden sm:inline">무료 상담 </span>{CONTACT.phone}
		</a>
	</div>
</header>
