---
import { CONTACT } from '../consts';

const steps = [
	{ no: '1', title: '현장 진단', body: '매장·상권·고객 흐름을 직접 보고 문제를 찾습니다.' },
	{ no: '2', title: '실행 계획', body: '오늘 바로 할 수 있는 순서로 정리해 드립니다.' },
	{ no: '3', title: '반복 학습', body: 'VOD 과정으로 필요할 때마다 다시 봅니다.' },
];
---

<section id="top" class="relative overflow-hidden bg-gradient-to-b from-cream-50 via-cream-100 to-cream-200">
	<!-- 은은한 그라데이션 빛무리 -->
	<div class="pointer-events-none absolute -top-40 -right-32 h-[30rem] w-[30rem] rounded-full bg-gradient-to-br from-brand-200/50 via-brand-100/35 to-transparent blur-3xl"></div>
	<div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-gradient-to-tr from-leaf-50 via-cream-300/50 to-transparent blur-3xl"></div>

	<div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 md:grid-cols-2 md:py-28">
		<div>
			<p class="rise rise-1 mb-5 inline-flex items-center gap-2 rounded-full border border-brand-200/70 bg-gradient-to-r from-cream-50 to-brand-50 px-4 py-1.5 text-xs font-semibold tracking-wide text-brand-700 shadow-sm">
				<span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-500"></span>
				소상공인 전문 컨설팅 · 온라인 VOD 과정
			</p>

			<h1 class="rise rise-2 text-4xl leading-[1.25] font-bold tracking-tight text-ink-900 sm:text-5xl">
				열심히 하는데 매출이 그대로라면,<br />
				<span class="bg-gradient-to-r from-brand-600 via-brand-500 to-amber-500 bg-clip-text text-transparent">
					방법을 바꿀 차례입니다.
				</span>
			</h1>

			<p class="rise rise-3 mt-6 text-lg leading-relaxed text-ink-700">
				소상공인 컨설턴트 {CONTACT.name}이 매장 현장 진단부터 온라인 홍보, 정부지원사업 준비까지
				1:1로 함께합니다. 배운 내용은 VOD 과정으로 언제든 다시 확인할 수 있습니다.
			</p>

			<div class="rise rise-4 mt-9 flex flex-col gap-3 sm:flex-row">
				<a
					href={CONTACT.phoneHref}
					class="rounded-2xl bg-gradient-to-r from-brand-500 to-brand-600 px-7 py-4 text-center text-base font-bold text-white shadow-xl shadow-brand-500/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-brand-500/35"
				>
					무료 상담 신청하기
				</a>
				<a
					href="#courses"
					class="rounded-2xl border border-cream-300 bg-cream-50/80 px-7 py-4 text-center text-base font-semibold text-ink-700 backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-200 hover:text-brand-700"
				>
					VOD 과정 둘러보기
				</a>
			</div>

			<p class="rise rise-4 mt-4 text-sm text-ink-500">
				상담 전화 {CONTACT.phone} · 첫 상담은 비용이 들지 않습니다.
			</p>
		</div>

		<div class="rise rise-3 rounded-3xl border border-cream-300/80 bg-gradient-to-br from-white via-cream-50 to-cream-200 p-8 shadow-2xl shadow-ink-900/5">
			<p class="font-display text-sm font-bold text-brand-700">이렇게 도와드립니다</p>

			<ul class="mt-6 space-y-5">
				{steps.map((step) => (
					<li class="flex gap-4">
						<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-600 font-display text-sm font-bold text-white shadow-md shadow-brand-500/25">
							{step.no}
						</span>
						<div>
							<p class="font-bold text-ink-900">{step.title}</p>
							<p class="mt-0.5 text-[15px] leading-relaxed text-ink-500">{step.body}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>
