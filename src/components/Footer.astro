---
import { CONTACT, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="bg-gradient-to-b from-cream-200 to-cream-300 text-ink-700">
	<div class="mx-auto max-w-6xl px-5 py-14">
		<div class="grid gap-8 md:grid-cols-2">
			<div>
				<p class="font-display text-lg font-bold text-ink-900">{SITE.name}</p>
				<p class="mt-2 text-sm">{CONTACT.name} · {CONTACT.role}</p>
			</div>

			<dl class="space-y-2 text-sm md:text-right">
				<div>
					<dt class="sr-only">전화번호</dt>
					<dd><a href={CONTACT.phoneHref} class="transition-colors hover:text-brand-700">{CONTACT.phone}</a></dd>
				</div>
				<div>
					<dt class="sr-only">이메일</dt>
					<dd><a href={CONTACT.emailHref} class="transition-colors hover:text-brand-700">{CONTACT.email}</a></dd>
				</div>
				<div>
					<dt class="sr-only">주소</dt>
					<dd>{CONTACT.address}</dd>
				</div>
			</dl>
		</div>

		<p class="mt-10 border-t border-cream-300 pt-6 text-xs text-ink-500">
			© {year} {SITE.name}. All rights reserved.
		</p>
	</div>
</footer>
