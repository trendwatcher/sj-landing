---
import { CONTACT, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400">
	<div class="mx-auto max-w-6xl px-5 py-14">
		<div class="grid gap-8 md:grid-cols-2">
			<div>
				<p class="text-lg font-bold text-white">{SITE.name}</p>
				<p class="mt-2 text-sm">{CONTACT.name} · {CONTACT.role}</p>
			</div>

			<dl class="space-y-2 text-sm md:text-right">
				<div>
					<dt class="sr-only">전화번호</dt>
					<dd><a href={CONTACT.phoneHref} class="hover:text-white">{CONTACT.phone}</a></dd>
				</div>
				<div>
					<dt class="sr-only">이메일</dt>
					<dd><a href={CONTACT.emailHref} class="hover:text-white">{CONTACT.email}</a></dd>
				</div>
				<div>
					<dt class="sr-only">주소</dt>
					<dd>{CONTACT.address}</dd>
				</div>
			</dl>
		</div>

		<p class="mt-10 border-t border-slate-800 pt-6 text-xs">
			© {year} {SITE.name}. All rights reserved.
		</p>
	</div>
</footer>
