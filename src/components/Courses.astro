---
import { LMS_URL } from '../consts';

/**
 * VOD 과정 목록. 과정이 늘어나면 이 배열에 같은 형식으로 추가하면 됩니다.
 * url 을 각 과정의 수강 페이지 주소로 바꾸면 카드마다 따로 연결할 수 있습니다.
 */
const courses = [
	{
		tag: '창업 준비',
		title: '아이템 선정 방법',
		body: '무엇을 팔 것인가부터 정합니다. 내 상황과 시장을 함께 놓고 아이템을 고르는 기준을 짚어 드립니다.',
		length: '맛보기 3분',
	},
	{
		tag: '지원사업 · 대출',
		title: '사업계획서 작성법',
		body: '심사위원이 무엇을 보는지부터 이해하고, 사업계획서를 항목별로 채워 나가는 순서를 익힙니다.',
		length: '맛보기 3분',
	},
];
---

<section id="courses" class="bg-gradient-to-b from-cream-200 via-brand-50 to-cream-100">
	<div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
		<div class="reveal mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold tracking-[0.2em] text-brand-600">ONLINE VOD</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
				온라인 강의로 언제든 다시 배웁니다
			</h2>
			<p class="mt-5 text-lg text-ink-700">
				바쁜 영업시간을 피해 새벽에도, 가게 문을 닫은 뒤에도 수강할 수 있습니다.
				필요한 과정만 골라 들으시면 됩니다.
			</p>
		</div>

		<div class="mx-auto mt-14 grid max-w-4xl gap-7 md:grid-cols-2">
			{courses.map((course) => (
				<article class="reveal group overflow-hidden rounded-3xl border border-cream-300/70 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink-900/5">
					{/*
						맛보기 영상 자리입니다. 실제 영상이 준비되면 아래 <div> 를 통째로 이렇게 바꾸세요.
						<div class="aspect-video">
						  <iframe class="h-full w-full" src="https://www.youtube.com/embed/영상아이디"
						    title="영상 제목" allowfullscreen loading="lazy"></iframe>
						</div>
					*/}
					<div class="relative flex aspect-video items-center justify-center overflow-hidden bg-gradient-to-br from-ink-900 via-brand-700 to-brand-500">
						<div class="pointer-events-none absolute -top-16 -right-10 h-48 w-48 rounded-full bg-gradient-to-br from-amber-300/30 to-transparent blur-2xl"></div>

						<div class="relative flex flex-col items-center gap-3 text-center">
							<span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/15 backdrop-blur transition-transform duration-300 group-hover:scale-110">
								<span class="ml-1 border-y-[10px] border-l-[16px] border-y-transparent border-l-white" aria-hidden="true"></span>
							</span>
							<span class="rounded-full bg-black/25 px-3 py-1 text-xs font-semibold text-white/90">
								맛보기 영상 준비 중
							</span>
						</div>

						<span class="absolute bottom-3 right-3 rounded-md bg-black/45 px-2 py-0.5 text-xs font-medium text-white/90">
							{course.length}
						</span>
					</div>

					<div class="p-7">
						<span class="inline-flex rounded-full bg-gradient-to-r from-brand-50 to-cream-200 px-3 py-1 text-xs font-bold text-brand-700">
							{course.tag}
						</span>
						<h3 class="mt-4 text-xl font-bold text-ink-900">{course.title}</h3>
						<p class="mt-3 leading-relaxed text-ink-700">{course.body}</p>
					</div>
				</article>
			))}
		</div>

		<div class="reveal mt-12 text-center">
			<a
				href={LMS_URL}
				class="inline-block rounded-2xl bg-gradient-to-r from-brand-500 to-brand-600 px-8 py-4 text-base font-bold text-white shadow-xl shadow-brand-500/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-brand-500/35"
			>
				전체 VOD 과정 보러 가기
			</a>
		</div>
	</div>
</section>
