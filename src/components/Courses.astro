---
import { LMS_URL } from '../consts';

/**
 * VOD 과정 목록. 과정이 늘어나면 이 배열에 같은 형식으로 추가하면 됩니다.
 * url 을 각 과정의 수강 페이지 주소로 바꾸면 카드마다 따로 연결할 수 있습니다.
 */
const courses = [
	{
		tag: '창업 준비',
		title: '아이템 선정 방법',
		body: '무엇을 팔 것인가부터 정합니다. 내 상황과 시장을 함께 놓고 아이템을 고르는 기준을 짚어 드립니다.',
	},
	{
		tag: '지원사업 · 대출',
		title: '사업계획서 작성법',
		body: '심사위원이 무엇을 보는지부터 이해하고, 사업계획서를 항목별로 채워 나가는 순서를 익힙니다.',
	},
];
---

<section id="courses" class="border-b border-slate-200 bg-slate-900">
	<div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold tracking-widest text-indigo-400">ONLINE VOD</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				온라인 강의로 언제든 다시 배웁니다
			</h2>
			<p class="mt-5 text-lg text-slate-300">
				바쁜 영업시간을 피해 새벽에도, 가게 문을 닫은 뒤에도 수강할 수 있습니다.
				필요한 과정만 골라 들으시면 됩니다.
			</p>
		</div>

		<div class="mx-auto mt-14 grid max-w-3xl gap-6 md:grid-cols-2">
			{courses.map((course) => (
				<div class="rounded-2xl border border-slate-700 bg-slate-800 p-8">
					<span class="inline-flex rounded-full bg-indigo-500/15 px-3 py-1 text-xs font-semibold text-indigo-300">
						{course.tag}
					</span>
					<h3 class="mt-4 text-xl font-bold text-white">{course.title}</h3>
					<p class="mt-3 leading-relaxed text-slate-300">{course.body}</p>
				</div>
			))}
		</div>

		<div class="mt-12 text-center">
			<a
				href={LMS_URL}
				class="inline-block rounded-xl bg-white px-8 py-4 text-base font-semibold text-slate-900 transition hover:bg-slate-100"
			>
				전체 VOD 과정 보러 가기
			</a>
		</div>
	</div>
</section>
