---
import { LMS_URL } from '../consts';

/**
 * VOD 과정 목록. 실제 과정 이름과 링크를 받으면 이 배열만 고치면 됩니다.
 * url 을 각 과정의 수강 페이지 주소로 바꾸면 카드마다 따로 연결됩니다.
 */
const courses = [
	{ tag: '온라인 홍보', title: '블로그·SNS 홍보 기초', body: '계정 개설부터 글 쓰는 순서까지, 처음부터 따라 할 수 있게 구성했습니다.' },
	{ tag: '매출 관리', title: '우리 가게 숫자 읽기', body: '매출·단가·재방문을 보고 어디를 고쳐야 할지 판단하는 방법을 배웁니다.' },
	{ tag: '지원사업', title: '정부지원사업 준비', body: '공고 찾는 법과 서류 준비 순서를 실제 사례로 익힙니다.' },
];
---

<section id="courses" class="border-b border-slate-200 bg-slate-900">
	<div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold tracking-widest text-indigo-400">ONLINE VOD</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				온라인 강의로 언제든 다시 배웁니다
			</h2>
			<p class="mt-5 text-lg text-slate-300">
				바쁜 영업시간을 피해 새벽에도, 가게 문을 닫은 뒤에도 수강할 수 있습니다.
				여러 과정이 준비되어 있습니다.
			</p>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-3">
			{courses.map((course) => (
				<div class="rounded-2xl border border-slate-700 bg-slate-800 p-7">
					<span class="inline-flex rounded-full bg-indigo-500/15 px-3 py-1 text-xs font-semibold text-indigo-300">
						{course.tag}
					</span>
					<h3 class="mt-4 text-lg font-bold text-white">{course.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-slate-300">{course.body}</p>
				</div>
			))}
		</div>

		<div class="mt-12 text-center">
			<a
				href={LMS_URL}
				class="inline-block rounded-xl bg-white px-8 py-4 text-base font-semibold text-slate-900 transition hover:bg-slate-100"
			>
				전체 VOD 과정 보러 가기
			</a>
		</div>
	</div>
</section>
