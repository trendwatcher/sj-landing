---
import { LMS_URL } from '../consts';

const base = import.meta.env.BASE_URL;

/**
 * VOD 과정 목록. 과정이 늘어나면 이 배열에 같은 형식으로 추가하면 됩니다.
 * video / poster 는 public/videos/ 안의 파일 이름입니다.
 * 실제 강의 영상이 준비되면 같은 이름으로 파일만 바꿔 넣으면 그대로 재생됩니다.
 */
const courses = [
	{
		tag: '창업 준비',
		title: '아이템 선정 방법',
		body: '무엇을 팔 것인가부터 정합니다. 내 상황과 시장을 함께 놓고 아이템을 고르는 기준을 짚어 드립니다.',
		video: 'item-selection',
		length: '미리보기 16초',
	},
	{
		tag: '지원사업 · 대출',
		title: '사업계획서 작성법',
		body: '심사위원이 무엇을 보는지부터 이해하고, 사업계획서를 항목별로 채워 나가는 순서를 익힙니다.',
		video: 'business-plan',
		length: '미리보기 16초',
	},
];
---

<section id="courses" class="bg-gradient-to-b from-cream-200 via-brand-50 to-cream-100">
	<div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
		<div class="reveal mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold tracking-[0.2em] text-brand-600">ONLINE VOD</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
				온라인 강의로 언제든 다시 배웁니다
			</h2>
			<p class="mt-5 text-lg text-ink-700">
				바쁜 영업시간을 피해 새벽에도, 가게 문을 닫은 뒤에도 수강할 수 있습니다.
				어떤 내용인지 미리보기 영상으로 먼저 확인해 보세요.
			</p>
		</div>

		<div class="mx-auto mt-14 grid max-w-4xl gap-7 md:grid-cols-2">
			{courses.map((course) => (
				<article class="reveal group overflow-hidden rounded-3xl border border-cream-300/70 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink-900/5">
					<div class="relative">
						<video
							class="aspect-video w-full bg-cream-200"
							src={`${base}videos/${course.video}.mp4`}
							poster={`${base}videos/${course.video}.jpg`}
							controls
							preload="none"
							playsinline
							aria-label={`${course.title} 과정 미리보기 영상`}
						>
							이 브라우저는 영상을 재생할 수 없습니다.
							<a href={`${base}videos/${course.video}.mp4`}>영상 파일 열기</a>
						</video>

						<span class="pointer-events-none absolute top-3 right-3 rounded-md bg-ink-900/55 px-2 py-0.5 text-xs font-medium text-white">
							{course.length}
						</span>
					</div>

					<div class="p-7">
						<span class="inline-flex rounded-full bg-gradient-to-r from-brand-50 to-cream-200 px-3 py-1 text-xs font-bold text-brand-700">
							{course.tag}
						</span>
						<h3 class="mt-4 text-xl font-bold text-ink-900">{course.title}</h3>
						<p class="mt-3 leading-relaxed text-ink-700">{course.body}</p>
					</div>
				</article>
			))}
		</div>

		<p class="reveal mt-8 text-center text-sm text-ink-500">
			미리보기 영상은 과정 안내용으로 제작한 것입니다. 전체 강의는 LMS 사이트에서 수강하실 수 있습니다.
		</p>

		<div class="reveal mt-8 text-center">
			<a
				href={LMS_URL}
				class="inline-block rounded-2xl bg-gradient-to-r from-brand-500 to-brand-600 px-8 py-4 text-base font-bold text-white shadow-xl shadow-brand-500/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-brand-500/35"
			>
				전체 VOD 과정 보러 가기
			</a>
		</div>
	</div>
</section>
