---
import { CONTACT } from '../consts';

const features = [
	{
		icon: '🔍',
		title: '현장을 직접 봅니다',
		body: '매장, 상권, 손님이 들어와서 나가기까지의 흐름을 함께 살펴봅니다. 서류가 아니라 현장에서 답을 찾습니다.',
	},
	{
		icon: '📈',
		title: '온라인으로 손님을 모읍니다',
		body: '블로그·SNS·지도 등록·리뷰 관리까지, 우리 가게에 맞는 것만 골라 순서대로 실행합니다.',
	},
	{
		icon: '🎬',
		title: '배운 내용이 남습니다',
		body: '상담으로 끝나지 않습니다. LMS VOD 과정으로 필요할 때마다 다시 보고, 직원에게도 같은 내용을 가르칠 수 있습니다.',
	},
];
---

<section id="solution" class="border-b border-slate-200 bg-slate-50">
	<div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold tracking-widest text-indigo-600">SOLUTION</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
				{CONTACT.name} 컨설턴트와 함께<br class="hidden sm:inline" />
				하나씩 정리해 나갑니다.
			</h2>
			<p class="mt-5 text-lg text-slate-600">
				한꺼번에 다 바꾸지 않습니다. 지금 가장 효과가 큰 것부터 순서대로 잡습니다.
			</p>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-3">
			{features.map((feature) => (
				<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
					<div class="text-3xl" aria-hidden="true">{feature.icon}</div>
					<h3 class="mt-5 text-xl font-bold text-slate-900">{feature.title}</h3>
					<p class="mt-3 leading-relaxed text-slate-600">{feature.body}</p>
				</div>
			))}
		</div>
	</div>
</section>
